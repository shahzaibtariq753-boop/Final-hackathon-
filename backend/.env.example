PORT=
# Frontend URL: used for links inside emails (first entry if comma-separated)
FRONTEND_URL=

# MongoDB Atlas connection string and database name
DB_URI=
DB_NAME=

# Long random string used to sign login tokens and hash one-time codes
SECRET_KEY=

# AI assistant: any OpenAI-compatible API with tool calling (Groq free tier by default)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Gmail SMTP for verification codes, password reset and task emails.
# Use a Gmail App Password (Google Account > Security > App passwords), never the normal Gmail password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=

# Email sign-in codes (HR/employees every sign-in, Admin first sign-in): auto (on when SMTP is set) | required | off
EMAIL_VERIFICATION=

# Optional: create the first Admin on startup instead of the setup screen
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=