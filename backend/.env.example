PORT=5000
NODE_ENV=development

# Create a MongoDB Atlas database user and paste its URL-encoded connection string.
MONGO_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/hcm_lite?retryWrites=true&w=majority

# Use at least 32 random characters, for example a value from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h

# Comma-separated frontend origins, without a trailing slash.
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=Asia/Karachi

# Optional: AI remains disabled until you configure a provider key.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
