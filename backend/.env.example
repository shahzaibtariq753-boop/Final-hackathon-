PORT=
# Allowed frontend origin(s) for browser API requests; separate multiple origins with commas.
FRONTEND_URL=

# MongoDB Atlas connection string and database name.
# DB_URI is also accepted as the MONGO_URI alias.
DB_URI=
DB_NAME=

# Private random string of at least 32 characters used to sign login tokens.
# SECRET_KEY is also accepted as the JWT_SECRET alias.
SECRET_KEY=

# AI assistant: any OpenAI-compatible API with tool calling (Groq free tier by default)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
